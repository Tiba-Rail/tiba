DATABASE_URL="postgresql://user:password@host:5432/tiba?sslmode=require"
GONKA_API_KEY="replace-with-a-local-secret"

# Nebius Token Factory (NVIDIA Nemotron). With NEBIUS_API_KEY set, the checks run on Nemotron;
# READER_PROVIDER=gonka switches them back to GonkaRouter. The model ids are optional overrides:
# `npm run nebius:models` lists the ids your key can call.
READER_PROVIDER=""
NEBIUS_API_KEY=""
NEBIUS_MODEL_SUPER=""
NEBIUS_MODEL_NANO=""
NEBIUS_MODEL_OMNI=""
# Optional: none | low | medium | high, sent as reasoning_effort on the two reader checks.
NEBIUS_REASONING_EFFORT=""
SEED_AGENT_KEY="tiba_testnet_demo_key"
NODE_ENV="development"
SUI_NETWORK="testnet"
SUI_ADDRESS="0x..."
SUI_PRIVATE_KEY="suiprivkey1..."
SUI_USDC_TYPE=""

# Solana devnet settlement. Each payout goes to the chain of the recipient's saved address
# (Solana if set, else Sui). SETTLEMENT_CHAIN (sui | solana, default sui) only picks the default
# for new recipients/workspaces and which treasury the fund page shows.
SETTLEMENT_CHAIN=""
NEXT_PUBLIC_SETTLEMENT_CHAIN=""
# Must be devnet.
SOLANA_NETWORK=""
SOLANA_ADDRESS=""
# Solana CLI JSON byte array (the contents of a solana-keygen keypair file).
SOLANA_PRIVATE_KEY=""
# Default https://api.devnet.solana.com
SOLANA_RPC_URL=""
NEXT_PUBLIC_SOLANA_RPC_URL=""
# Default Circle devnet USDC 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDC_MINT=""

# Terminal 3 identity (optional). Without these Tiba uses the mock provider.
# T3_API_KEY is the account private key and is used ONLY by `npm run t3:demo`
# to provision the org and agent. The server never needs it.
IDENTITY_PROVIDER="mock"
T3_API_KEY=""
T3_AGENT_API_KEY=""
T3_NODE_URL="https://cn-api.sg.testnet.t3n.terminal3.io"
T3_VERIFY_TTL_SECONDS="3600"
