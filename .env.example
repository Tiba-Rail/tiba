DATABASE_URL="postgresql://user:password@host:5432/tiba?sslmode=require"
GROQ_API_KEY="replace-with-a-local-secret"
SEED_AGENT_KEY=""
NODE_ENV="development"
# Which live settlement rail this deployment uses. solana (default) or tempo.
# Mock wallets stay mock either way. Never put a real key in this file.
RAIL="solana"

# Solana devnet. Used when RAIL=solana.
# Chain id for Solana is the cluster name; settlement refuses anything but devnet.
SOLANA_NETWORK=""
SOLANA_ADDRESS=""
# Treasury key. Solana CLI JSON byte array (the contents of a solana-keygen keypair file).
SOLANA_PRIVATE_KEY=""
# Default https://api.devnet.solana.com
SOLANA_RPC_URL=""
# Second devnet RPC. A payout is recorded as paid only when this endpoint and
# SOLANA_RPC_URL both report the same successful signature. Default
# https://solana-devnet.gateway.tatum.io
SOLANA_RPC_URL_2=""
NEXT_PUBLIC_SOLANA_RPC_URL=""
# Stablecoin mint. Default Circle devnet USDC 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_USDC_MINT=""
# Explorer origin. Default https://explorer.solana.com — tx links are /tx/<signature>?cluster=devnet
SOLANA_EXPLORER_BASE=""

# Tempo Moderato (testnet). Used when RAIL=tempo. Chain id 42431 only.
# Default RPC https://rpc.moderato.tempo.xyz
TEMPO_RPC_URL=""
TEMPO_CHAIN_ID="42431"
# Stablecoin contract. Default pathUSD 0x20c0000000000000000000000000000000000000
TEMPO_STABLECOIN_ADDRESS=""
# Explorer origin. Default https://explore.testnet.tempo.xyz — tx links are /tx/<hash>
TEMPO_EXPLORER_BASE=""
# Treasury key. 0x-prefixed 32-byte hex. Never commit a real key.
TEMPO_TREASURY_KEY=""
# Optional. When set, settlement refuses if the key does not match this address.
TEMPO_TREASURY_ADDRESS=""
# Live (Solana devnet) wallets that signed-in users may create at /start per 24 hours, across
# the whole deployment. Anonymous wallets are always simulated. Default 20.
LIVE_ONBOARDING_DAILY_CAP="20"

# Terminal 3 identity (optional). Without these Tiba uses the mock provider.
# T3_API_KEY is the account private key and is used ONLY by `npm run t3:demo`
# to provision the org and agent. The server never needs it.
IDENTITY_PROVIDER="mock"
T3_API_KEY=""
T3_AGENT_API_KEY=""
T3_NODE_URL="https://cn-api.sg.testnet.t3n.terminal3.io"
T3_VERIFY_TTL_SECONDS="3600"
