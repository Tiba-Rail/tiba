generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rail {
  mock
  legacy @map("sui")
  solana
}

model Agent {
  id                String   @id @default(uuid())
  name              String
  apiKeyHash        String   @unique @map("api_key_hash")
  apiKeyPrefix      String   @map("api_key_prefix")
  ownerTokenHash    String?  @unique @map("owner_token_hash")
  ownerTokenPrefix  String?  @map("owner_token_prefix")
  ceilingMicros     BigInt   @map("ceiling_micros")
  hourCapMicros     BigInt   @map("hour_cap_micros")
  dayCapMicros      BigInt   @map("day_cap_micros")
  hourCountCap      Int      @map("hour_count_cap")
  dayCountCap       Int      @map("day_count_cap")
  spentMicrosDay    BigInt   @default(0) @map("spent_micros_day")
  spentMicrosHour   BigInt   @default(0) @map("spent_micros_hour")
  windowStartedAt   DateTime @default(now()) @map("window_started_at")
  dayStartedAt      DateTime @default(now()) @map("day_started_at")
  countDay          Int      @default(0) @map("count_day")
  countHour         Int      @default(0) @map("count_hour")
  killSwitch        Boolean  @default(false) @map("kill_switch")
  requireRecipientKyc Boolean @default(false) @map("require_recipient_kyc")
  rail              Rail     @default(mock)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  userId            String?  @map("user_id")

  intents           PayoutIntent[]

  @@map("agents")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Recipient {
  id          String   @id @default(uuid())
  ref         String   @unique
  displayName String   @map("display_name")
  legacyAddress  String?  @map("sui_address")
  // Retains pre-Solana-only records without making them payable.
  solanaAddress String? @map("solana_address")
  active      Boolean  @default(true)
  kycStatus   String   @default("unverified") @map("kyc_status")
  kycProvider String?  @map("kyc_provider")
  kycCheckId  String?  @map("kyc_check_id")
  kycVerifiedAt DateTime? @map("kyc_verified_at")
  kycExpiresAt  DateTime? @map("kyc_expires_at")
  // Terminal 3 identity, set when a recipient links one. Null for everyone else.
  t3nDid        String?   @map("t3n_did")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workOrders  WorkOrder[]
  intents     PayoutIntent[]

  @@map("recipients")
}

model WorkOrder {
  id                    String   @id @default(uuid())
  recipientId           String   @map("recipient_id")
  ref                   String   @unique
  ceilingMicros         BigInt   @map("ceiling_micros")
  briefText             String   @map("brief_text")
  payerRecord           Json     @map("payer_record")
  requiredChannels      String   @default("both") @map("required_channels")
  expiresAt             DateTime @map("expires_at")
  status                String   @default("open")
  dischargedByIntentId  String?  @unique @map("discharged_by_intent_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  recipient             Recipient    @relation(fields: [recipientId], references: [id])
  intents               PayoutIntent[]

  @@index([recipientId, status, expiresAt])
  @@map("work_orders")
}

model PayoutIntent {
  id               String   @id @default(uuid())
  agentId          String   @map("agent_id")
  workOrderId      String?  @map("work_order_id")
  recipientId      String   @map("recipient_id")
  amountMicros     BigInt   @default(0) @map("amount_micros")
  status           String
  reasonCode       String?  @map("reason_code")
  decisionClass    String   @map("decision_class")
  idempotencyKey   String   @unique @map("idempotency_key")
  digest           String?
  explorerUrl      String?  @map("explorer_url")
  // Chain that settled (or was tried): "solana" | "mock". Old rows keep their stored history.
  chain            String?  @map("chain")
  gnkUsd           String?  @map("gnk_usd")
  pricingUpdatedAt DateTime? @map("pricing_updated_at")
  publicToken      String   @unique @map("public_token")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  agent            Agent       @relation(fields: [agentId], references: [id])
  workOrder        WorkOrder?  @relation(fields: [workOrderId], references: [id])
  recipient        Recipient   @relation(fields: [recipientId], references: [id])
  adjudications    Adjudication[]
  artifact         Artifact?

  @@index([agentId, createdAt])
  @@map("payout_intents")
}

model Adjudication {
  id           String   @id @default(uuid())
  intentId     String   @map("intent_id")
  channel      String
  model        String
  requestId    String?  @map("request_id")
  fallback     String?  @map("gonka_fallback")
  promptSha    String   @map("prompt_sha")
  responseSha  String?  @map("response_sha")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  latencyMs    Int      @map("latency_ms")
  tupleJson    Json?    @map("tuple_json")
  ok           Boolean
  createdAt    DateTime @default(now()) @map("created_at")

  intent       PayoutIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
  @@map("adjudications")
}

model Artifact {
  id         String   @id @default(uuid())
  intentId   String   @unique @map("intent_id")
  rawText    String   @map("raw_text")
  sha256     String
  untrusted  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  intent     PayoutIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@map("artifacts")
}

// Which Tiba wallet a Telegram chat pays from. Set with /connect; without a row
// the chat falls back to the pilot wallet in the environment.
model TelegramChat {
  chatId    String   @id @map("chat_id")
  agentKey  String   @map("agent_key")
  ownerKey  String   @map("owner_key")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("telegram_chats")
}
